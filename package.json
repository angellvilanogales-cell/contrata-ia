{
  "name": "contrata-ia",
  "version": "0.1.0",
  "private": true,
  "description": "Asistente inteligente para la contratación pública y la generación de expedientes conforme a la Ley 9/2017 de Contratos del Sector Público (LCSP).",
  "license": "UNLICENSED",
  "main": "dist/main.js",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "typecheck": "node scripts/typecheck.mjs",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "start": "node dist/main.js",
    "serve": "node dist/main.js --serve",
    "serve:pilot": "node scripts/start-pilot.mjs",
    "demo:vertical": "node dist/main.js --vertical-demo",
    "demo:lb4": "node dist/main.js --lb4-cleaning-demo",
    "demo:lb5": "node dist/main.js --lb5-documents-demo",
    "demo:lb6": "node dist/main.js --lb6-intake-demo",
    "audit:imports": "node scripts/check-relative-imports.mjs",
    "audit:architecture": "node scripts/audit-architecture.mjs",
    "audit:knowledge": "node scripts/validate-knowledge-integrity.mjs",
    "audit:knowledge:integrity": "node scripts/validate-knowledge-integrity.mjs",
    "audit:normative": "node scripts/audit-lb4-normative.mjs",
    "audit:documents": "node scripts/audit-lb5-documents.mjs",
    "audit:lb6": "node scripts/audit-lb6.mjs",
    "audit:lb7": "node scripts/audit-lb7.mjs"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2",
    "vitest": "^3.0.0"
  }
}
