{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./dist",
    "types": ["node"]
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "dist-test",
    "tests",
    "test",
    "knowledge/**/*.ts",
    "**/*.test.ts",
    "**/*.spec.ts"
  ]
}
