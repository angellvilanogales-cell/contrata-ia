{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./dist",
    "types": [
      "node"
    ]
  },
  "include": [
    "src/**/*.ts",
    "knowledge/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "tests",
    "test",
    "**/*.test.ts",
    "**/*.spec.ts"
  ]
}
